Host dev
  HostName unit1.lan
  User ryan
  Port 22
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ForwardAgent no
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host kdai 128.163.188.196
  HostName 128.163.188.196
  User Administrator
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host ukcdar ukcdar.uky.edu
  HostName ukcdar.uky.edu
  User AD\rs_cdaradministrator
  # Key auth succeeds but the key-derived session is killed at shell-spawn
  # (Windows token/EDR issue). Pin to the working password path for now.
  # Once key sessions work, delete the next two lines to go passwordless.
  PubkeyAuthentication no
  PreferredAuthentications password,keyboard-interactive
  # Connection multiplexing: authenticate ONCE, then every later ssh/scp/rsync
  # to this host reuses the live connection with no re-auth.
  ControlMaster auto
  ControlPath ~/.ssh/cm/%C
  ControlPersist 4h
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host bscfs bscfs.ad.uky.edu
  HostName bscfs.ad.uky.edu
  User AD\rs_cdaradministrator
  # Same AD account as ukcdar -> expect the same non-elevated + dead-key-session
  # behavior, so pin to password + multiplex. Server-side "default shell -> pwsh"
  # is a separate elevated-RDP step once SSH is enabled on the box.
  PubkeyAuthentication no
  PreferredAuthentications password,keyboard-interactive
  ControlMaster auto
  ControlPath ~/.ssh/cm/%C
  ControlPersist 4h
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host kdai-web ukcdar-redirect ukcdar-redirect.ad.uky.edu 128.163.188.24
  HostName 128.163.188.24
  # Migrated KDAI DotNetNuke web server (original KDAI web box died ~2026-06;
